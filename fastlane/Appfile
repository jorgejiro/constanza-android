package_name("com.jjrapps.constanza")

# The Play service-account key authenticates as Constanza's Play Console account, so it never lives
# inside the repo. Two sources, in this order:
#
# 1. ANDROID_CONSTANZA_JSON_KEY — the JSON content itself, as Bitwarden Secrets Manager injects it:
#    `con-claves 'fastlane subir'`. Nothing is written to disk.
# 2. The file ~/.config/play/jjrmobileapps.json, for a Mac without Bitwarden access.
#
# Do not define SUPPLY_JSON_KEY (the key's former name): supply reads that variable on its own, and
# when it is present it silently wins over the Bitwarden key (its conflicting-options check only
# covers options passed to the action, so no error is raised).
play_key_json = ENV["ANDROID_CONSTANZA_JSON_KEY"].to_s
if play_key_json.strip.empty?
  json_key_file(File.expand_path("~/.config/play/jjrmobileapps.json"))
else
  json_key_data_raw(play_key_json)
end
