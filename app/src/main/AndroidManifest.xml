<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ConstanzaApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Constanza">

        <activity
            android:name=".core.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Constanza">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- design.md §9.1/§12: the AlarmManager PendingIntent target. Private to this app. -->
        <receiver
            android:name=".scheduling.ReminderFireReceiver"
            android:exported="false" />

    </application>

</manifest>
