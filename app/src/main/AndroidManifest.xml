<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The habit database never leaves the device on its own. Auto Backup was on - explicitly
         written, but also the platform default, so it read as template rather than as a decision -
         and it silently restored every habit from the owner's Google Drive after a deliberate
         uninstall-and-reinstall, which is how an uninstall stopped meaning "start clean". Turning
         it off is a decision about where personal data lives: preserving it across a reinstall or
         a new phone is what DataPortabilityScreen's export/import is for, an explicit file the
         user chooses, keeps and can read. `dataExtractionRules` closes the other half - on API 31+
         device-to-device transfer is configured separately and this flag alone would not stop it.
         AutoBackupDisabledInstrumentedTest asserts the flag on a real device rather than trusting
         this comment. -->
    <application
        android:name=".ConstanzaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Constanza"
        tools:targetApi="33">

        <!-- Task 5.9 discovery: this auto-initializer ran before Hilt injected `workerFactory`,
             so every worker fell back to a bare reflective constructor. Removed here;
             ConstanzaApplication calls `WorkManager.initialize()` itself, after Hilt injection. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".core.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Constanza">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- design.md §9.3: the five mandatory reschedule triggers plus the exact-alarm permission
             state change. exported=true is safe here — every one of these actions is a protected
             system broadcast; only the system UID may send them regardless of this flag. -->
        <receiver
            android:name=".scheduling.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".scheduling.PackageReplacedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".scheduling.TimeChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".scheduling.ExactAlarmPermissionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- design.md §9.1/§12: the AlarmManager PendingIntent target. Private to this app. -->
        <receiver
            android:name=".scheduling.ReminderFireReceiver"
            android:exported="false" />

        <!-- design.md §9.1/§12: the notification-action PendingIntent target
             (`ActionIntentContract.ACTION_RECEIVER_CLASS`). No intent-filter: every PendingIntent
             targets this component explicitly via `setClassName`, so a filter would only widen the
             surface with no benefit. Private to this app. -->
        <receiver
            android:name=".reminding.ActionReceiver"
            android:exported="false" />

    </application>

</manifest>
