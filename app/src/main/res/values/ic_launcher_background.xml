<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The adaptive icon's background layer. It is a flat fill, so it is a colour resource rather
        than a drawable: <adaptive-icon>'s <background> accepts a colour directly, and a
        one-colour vector or shape drawable would only be another file to keep in sync.

        #110B06 is the original warm-dark ground the icon was designed on. The graphite redesign
        moved the in-app background to #141416 but left the launcher icon unchanged on purpose;
        nothing binds this colour to the app theme.
    -->
    <color name="ic_launcher_background">#110B06</color>
</resources>
