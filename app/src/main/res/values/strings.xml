    <string name="today_slot_pending">Pending</string>
    <!-- today-row-answering-is-cramped-and-always-on, defect 2: one per EntryStatus, so a slot's
         answered state is copy like everything else instead of the Kotlin constant leaking through
         `EntryStatus.name`. Deliberately shorter than their day-level counterparts above — a slot
         line already carries its time, and this sits beside three buttons on one row. UNKNOWN maps
         to today_slot_pending, which already existed and already said the right thing. -->
    <string name="today_slot_completed">Done</string>
    <string name="today_slot_missed">Missed</string>
    <string name="today_slot_skipped">Skipped</string>
    <!-- today-row-alignment: the leading "Pending, " is gone. A snoozed slot is self-evidently
         unanswered, so the word bought nothing and cost the row a wrapped line: at 360dp the status
         column is 109dp wide and this is the longest string that can land in it. -->
    <string name="today_slot_pending_snoozed_until">Snoozed until %1$s</string>

    <!-- habit-entry-tracking: in-app Entry write path, SKIPPED is in-app only (task 6b.2).
         today-one-line-row: today_answer_skip ("Omitir") is gone — the row no longer offers a
         third answer control at all, only these two pills. Skip is still reachable, through the
         change dialog's third option, which reuses today_slot_skipped ("Omitido"/"Skipped")
         instead — a status label rather than an imperative, matching that dialog's past-tense
         framing of an already-made choice. -->
    <string name="today_answer_yes">Yes</string>
    <string name="today_answer_no">No</string>
    <!-- today-one-line-row: each pill's own accessible label — the visible "Yes"/"No" alone
         carries no habit context for TalkBack, and a screen full of identical bare "Yes" pills
         would announce identically for every habit. -->
    <string name="today_answer_yes_a11y">Answer yes for %1$s</string>
    <string name="today_answer_no_a11y">Answer no for %1$s</string>
    <!-- today-clear-answer: the change dialog's fourth option — undoes an answer rather than
         writing a fourth status (habit-entry-tracking: an unanswered slot must still become
         Missed at midnight). Offered only for today or a future date: on a past day the midnight
         law has already decided, so "Not answered" and "No" are the same outcome there, and this
         option is withheld (ChangeAnswerDialog in TodayChangeAnswerDialog.kt). -->
    <string name="today_answer_not_answered">Not answered</string>

    <!-- today-one-line-row: an answered slot's row is itself the tap target now that "Cambiar" is
