<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Minimal launch theme for the Activity window before Compose takes over. Compose content
        itself is themed with Material 3 (core/ui/theme/Theme.kt); this XML theme only needs to be
        a valid NoActionBar window background — no extra AppCompat/Material XML library needed.
    -->
    <style name="Theme.Constanza" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
